# Smart Resume Screener Backend Configuration

# Database: SQLite for local dev, or PostgreSQL (e.g. postgresql://user:password@localhost:5432/screener)
DATABASE_URL=sqlite:///./screener.db

# LLM Provider: 'gemini' or 'demo'
LLM_PROVIDER=gemini

# Google Gemini API Key (Leave blank to automatically operate in high-fidelity Demo Mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Force Demo Mode (true/false)
DEMO_MODE=true

# Security & Uploads
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
