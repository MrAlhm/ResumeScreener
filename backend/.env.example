PROJECT_NAME="UNTHINKABLE Smart Resume Screener"
VERSION="1.0.0"
API_V1_STR="/api"

# Database Configuration
DATABASE_URL=sqlite:///./screener.db

# Self-Contained Built-in Semantic Matching Engine (No external API keys required)
LLM_PROVIDER=built_in

# Security & CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80","http://127.0.0.1:5173","http://127.0.0.1:8000","*"]
