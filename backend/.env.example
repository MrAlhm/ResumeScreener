PROJECT_NAME="UNTHINKABLE Smart Resume Screener"
VERSION="1.0.0"
API_V1_STR="/api"

# Database Configuration
DATABASE_URL=sqlite:///./screener.db

# LLM Configuration (demo or gemini)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Security & CORS
SECRET_KEY=unthinkable_production_secret_key_change_me
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80","http://127.0.0.1:5173","http://127.0.0.1:8000"]
