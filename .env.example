# ==========================================
# SMART RESUME SCREENER CONFIGURATION
# ==========================================

# Database URL (SQLite default, or PostgreSQL)
DATABASE_URL=sqlite:///./screener.db

# LLM Provider ('gemini' or 'demo')
LLM_PROVIDER=gemini

# Google Gemini API Key (Leave blank to use Demo Mode automatically)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Force Demo Mode (true/false)
DEMO_MODE=true

# File Upload Limit in Megabytes
MAX_FILE_SIZE_MB=10
